# Plantilla procesada con envsubst por la imagen oficial al arrancar el contenedor
# (resultado en /etc/nginx/conf.d/default.conf). Variables: BACKEND_URL, MAX_SUBIDA.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Debe cubrir el límite de subida de vídeo del backend (nginx admite solo 1 MB por defecto)
    client_max_body_size ${MAX_SUBIDA};

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # DNS interno de Docker: el backend se resuelve en cada petición, así nginx arranca aunque
    # el backend aún no exista y no se queda con una IP antigua cuando se reinicia
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend ${BACKEND_URL};

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Subidas en streaming hacia el backend, sin guardarlas antes en disco
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Recursos con hash en el nombre: caché de un año
    location /assets/ {
        expires 1y;
        access_log off;
        try_files $uri =404;
    }

    # index.html, el service worker y el manifest siempre se revalidan para recibir las versiones nuevas
    location = /index.html {
        expires -1;
    }

    location ~ ^/(sw\.js|registerSW\.js|manifest\.webmanifest)$ {
        expires -1;
        try_files $uri =404;
    }

    # Rutas de la PWA: cualquier ruta que no sea un archivo carga la aplicación
    location / {
        try_files $uri $uri/ /index.html;
    }
}
