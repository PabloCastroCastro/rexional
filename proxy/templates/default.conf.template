# Plantilla procesada con envsubst por la imagen oficial al arrancar el contenedor
# (resultado en /etc/nginx/conf.d/default.conf). Variables: BACKEND_URL, MAX_SUBIDA.
#
# HTTP en 8080: el que usan la CI, el entorno local y el healthcheck. En el servidor, si hay
# certificado montado en /etc/nginx/certs, se añade además HTTPS en 8443 (ver
# docker-entrypoint.d/40-https.sh). Los dos sirven lo mismo: vestuario.inc.
server {
    listen 8080;
    server_name _;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    include /etc/nginx/conf.d/vestuario.inc;
}
