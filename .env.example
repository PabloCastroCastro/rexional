# Configuración de Docker Compose. Cópialo como .env y ajústalo.
# En el servidor hay un .env por entorno (pruebas y producción). Nunca se versiona el .env.
# En desarrollo (docker-compose.dev.yml) todas las variables tienen valor por defecto y el .env es opcional.

# Puerto del host en el que escucha el proxy, el único puerto publicado.
# Cada entorno del servidor usa uno distinto.
PUERTO=8080

# PostgreSQL. La contraseña es obligatoria en el servidor: larga y solo con letras y
# números, porque va dentro de la URL de conexión del backend.
POSTGRES_DB=vestuario
POSTGRES_USER=vestuario
POSTGRES_PASSWORD=

# Tamaño máximo de una subida, en formato de nginx (200m, 1g)
MAX_SUBIDA=200m

# Zona horaria de todos los servicios
TZ=Europe/Madrid

# --- Solo desarrollo ---

# Puerto local de PostgreSQL
PUERTO_DB=5432

# true si la recarga en caliente del frontend no detecta los cambios (p. ej. en Windows)
VITE_USE_POLLING=false
