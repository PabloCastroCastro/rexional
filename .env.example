# Configuración de Docker Compose. Cópialo como .env y ajústalo.
# En el servidor hay un .env por entorno (pruebas y producción). Nunca se versiona el .env.
# En desarrollo (docker-compose.dev.yml) todas las variables tienen valor por defecto y el .env es opcional.

# Entorno del servidor: pruebas o produccion. En pruebas se permite cargar datos de ejemplo (seed)
ENTORNO=produccion

# Puerto del host en el que escucha el proxy, el único puerto publicado.
# Cada entorno del servidor usa uno distinto.
PUERTO=8080

# Puerto del proxy que se publica: 8080 (HTTP, en local y en la CI) o 8443 (HTTPS, en el servidor,
# con el certificado de Tailscale montado por docker-compose.servidor.yml). Ver docs/servidor.md
PUERTO_INTERNO=8080

# Solo servidor: directorio con cert.pem y key.pem (los deja ahí scripts/renovar-cert.sh)
CERTIFICADOS=/opt/vestuario/certs

# PostgreSQL. La contraseña es obligatoria en el servidor: larga y solo con letras y
# números, porque va dentro de la URL de conexión del backend.
POSTGRES_DB=vestuario
POSTGRES_USER=vestuario
POSTGRES_PASSWORD=

# Dirección desde la que se usa la aplicación en este entorno, con su puerto si no es el 443.
# Solo se aceptan inicios de sesión desde esta dirección.
URL_PUBLICA=https://raspberry.tu-tailnet.ts.net:8443

# Clave que firma las cookies de sesión. Obligatoria, distinta en cada entorno y secreta.
# Genérala con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Nivel de log del backend: fatal, error, warn, info, debug o trace
LOG_LEVEL=info

# Tamaño máximo de una subida, en formato de nginx (200m, 1g); debe cubrir MAX_VIDEO_MB
MAX_SUBIDA=200m

# Tamaño máximo de cada foto y de cada vídeo de los ejercicios, en MB
MAX_FOTO_MB=15
MAX_VIDEO_MB=150

# Zona horaria de todos los servicios
TZ=Europe/Madrid

# --- Solo desarrollo ---

# Puerto local de PostgreSQL
PUERTO_DB=5432

# true para detectar los cambios por sondeo en backend y frontend. Necesario si el código está
# en el sistema de archivos de Windows (C:\...): los cambios no llegan como eventos a los contenedores
RECARGA_POLLING=false
