{
  "openapi": "3.1.0",
  "info": {
    "title": "API de Vestuario",
    "version": "0.1.0",
    "description": "API REST de Vestuario. Todas las rutas cuelgan de /api. Errores con el formato { error: { codigo, mensaje, detalles? } }."
  },
  "components": {
    "schemas": {
      "Salud": {
        "type": "object",
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "description": "ok solo si todos los componentes funcionan"
          },
          "api": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "baseDeDatos": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          }
        },
        "required": [
          "estado",
          "api",
          "baseDeDatos"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "codigo": {
                "type": "string",
                "example": "validacion"
              },
              "mensaje": {
                "type": "string",
                "example": "Los datos enviados no son válidos"
              },
              "detalles": {}
            },
            "required": [
              "codigo",
              "mensaje"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Club": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "escudo": {
            "type": [
              "string",
              "null"
            ]
          },
          "colorPrincipal": {
            "type": "string",
            "example": "#14553d"
          },
          "colorSecundario": {
            "type": "string",
            "example": "#f2c230"
          },
          "esAdmin": {
            "type": "boolean",
            "description": "Si el usuario es administrador del club"
          }
        },
        "required": [
          "id",
          "nombre",
          "escudo",
          "colorPrincipal",
          "colorSecundario",
          "esAdmin"
        ]
      },
      "AdministradorClub": {
        "type": "object",
        "properties": {
          "usuarioId": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "usuarioId",
          "nombre",
          "email"
        ]
      },
      "PlantillaConClub": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Plantilla"
          },
          {
            "type": "object",
            "properties": {
              "club": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "nombre": {
                    "type": "string"
                  },
                  "escudo": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "colorPrincipal": {
                    "type": "string"
                  },
                  "colorSecundario": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "nombre",
                  "escudo",
                  "colorPrincipal",
                  "colorSecundario"
                ]
              }
            },
            "required": [
              "club"
            ]
          }
        ]
      },
      "Plantilla": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "clubId": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string",
            "example": "Senior"
          },
          "categoria": {
            "type": "string",
            "example": "sénior"
          },
          "temporada": {
            "type": "string",
            "example": "2026-27"
          },
          "plantillaAnteriorId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "rol": {
            "type": "string",
            "enum": [
              "admin",
              "entrenador",
              "delegado",
              "jugador"
            ],
            "description": "Rol efectivo del usuario en la plantilla"
          },
          "esAdminClub": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "clubId",
          "nombre",
          "categoria",
          "temporada",
          "plantillaAnteriorId",
          "rol",
          "esAdminClub"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Salud"
        ],
        "summary": "Estado de la API y de la base de datos",
        "description": "Lo usa el healthcheck de Docker: responde 503 si la base de datos no está disponible.",
        "responses": {
          "200": {
            "description": "Todo funciona",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Salud"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "La base de datos no responde",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Salud"
                }
              }
            }
          }
        }
      }
    },
    "/api/clubes": {
      "get": {
        "tags": [
          "Clubes"
        ],
        "summary": "Mis clubes",
        "description": "Clubes que el usuario administra o en los que tiene un rol en alguna plantilla. Incluye los clubes sin plantillas que administra.",
        "responses": {
          "200": {
            "description": "Clubes del usuario",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Club"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Clubes"
        ],
        "summary": "Crear un club",
        "description": "Quien lo crea pasa a ser su administrador, en la misma transacción.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "nombre"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Club creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Club"
                }
              }
            }
          },
          "400": {
            "description": "Datos no válidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/clubes/{cid}": {
      "get": {
        "tags": [
          "Clubes"
        ],
        "summary": "Datos e identidad visual de un club",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "cid",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Club",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Club"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/clubes/{cid}/admins": {
      "get": {
        "tags": [
          "Clubes"
        ],
        "summary": "Administradores del club",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "cid",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Administradores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AdministradorClub"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Clubes"
        ],
        "summary": "Añadir un administrador",
        "description": "El usuario debe existir. Las invitaciones por email llegan en el ciclo 9.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "cid",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Administrador añadido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdministradorClub"
                }
              }
            }
          },
          "400": {
            "description": "Datos no válidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Ya es administrador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/clubes/{cid}/admins/{uid}": {
      "delete": {
        "tags": [
          "Clubes"
        ],
        "summary": "Retirar un administrador",
        "description": "Un club nunca se queda sin administradores.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "cid",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "uid",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Administrador retirado"
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Es el último administrador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/plantillas": {
      "get": {
        "tags": [
          "Plantillas"
        ],
        "summary": "Mis plantillas",
        "description": "Plantillas en las que el usuario tiene un rol y todas las de los clubes que administra, ordenadas por club, temporada (la más reciente primero) y nombre. Con `club`, solo las de ese club.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "club",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Plantillas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlantillaConClub"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos no válidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Plantillas"
        ],
        "summary": "Crear una plantilla",
        "description": "Solo los administradores del club. Para la temporada siguiente, indica la plantilla anterior (del mismo club y de una temporada anterior).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "clubId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "nombre": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "categoria": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "temporada": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}$",
                    "example": "2026-27"
                  },
                  "plantillaAnteriorId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uuid"
                  }
                },
                "required": [
                  "clubId",
                  "nombre",
                  "categoria",
                  "temporada"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Plantilla creada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plantilla"
                }
              }
            }
          },
          "400": {
            "description": "Datos no válidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Ya existe una plantilla con ese nombre en la temporada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/plantillas/{id}": {
      "get": {
        "tags": [
          "Plantillas"
        ],
        "summary": "Una plantilla",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Plantilla",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plantilla"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Plantillas"
        ],
        "summary": "Cambiar el nombre o la categoría",
        "description": "Entrenador o superior. La temporada no se modifica.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "categoria": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plantilla actualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plantilla"
                }
              }
            }
          },
          "400": {
            "description": "Datos no válidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Ya existe una plantilla con ese nombre en la temporada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Plantillas"
        ],
        "summary": "Borrar una plantilla",
        "description": "Solo los administradores del club, escribiendo el nombre de la plantilla como confirmación. Borra sus fichas, cuerpo técnico y datos; los jugadores siguen en el club.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "confirmacion": {
                    "type": "string"
                  }
                },
                "required": [
                  "confirmacion"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Plantilla borrada"
          },
          "400": {
            "description": "La confirmación no coincide con el nombre",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
